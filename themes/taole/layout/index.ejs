<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>" data-theme="light">
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <%- partial('_partial/page-bg') %>
  <%- partial('_partial/header') %>

  <%
    var hero = theme.hero || {};
    var posts = page.posts ? page.posts.toArray() : [];
    var totalPosts = site.posts.length;
    var totalTopics = (theme.topics || []).length;
    var sinceYear = '2025';
    if (totalPosts) {
      var oldest = site.posts.sort('date', 1).first();
      if (oldest) sinceYear = date(oldest.date, 'YYYY');
    }
  %>

  <% if (hero.enable !== false) { %>
  <section class="hero">
    <div class="wrap">
      <div class="hero-main">
        <% if (hero.badge) { %>
          <span class="hero-tag"><span class="dot"></span><%= hero.badge %></span>
        <% } %>
        <h1><%= hero.title || '' %><em><%= hero.highlight || '' %></em></h1>
        <% if (hero.subtitle) { %><p><%= hero.subtitle %></p><% } %>
        <div class="hero-stats">
          <div class="stat"><div class="num"><%= totalPosts %></div><div class="lbl">Articles</div></div>
          <div class="stat"><div class="num"><%= totalTopics %></div><div class="lbl">板块</div></div>
          <div class="stat"><div class="num"><%= sinceYear %></div><div class="lbl">Since</div></div>
        </div>
      </div>

      <aside class="hero-side">
        <% var siteAuthor = default_author(); %>
        <img class="hero-avatar" src="<%= siteAuthor.avatar %>" width="96" height="96" alt="<%= siteAuthor.name %> 的头像" decoding="async" referrerpolicy="no-referrer" onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src='<%- url_for('/images/avatar.jpg') %>';}">
        <div class="name"><%= siteAuthor.name %></div>
        <p class="quote"><%= theme.signature %></p>
        <% if (siteAuthor.url) { %>
          <div class="social">
            <a href="<%= siteAuthor.url %>" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.81-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
            </a>
          </div>
        <% } %>
      </aside>
    </div>
  </section>
  <% } %>

  <main class="wrap">
    <div class="layout">
      <div>
        <div class="section-head">
          <h2>最新文章</h2>
          <span>共 <%= totalPosts %> 篇</span>
        </div>

        <div class="post-list">
          <% if (posts.length) { %>
            <% posts.forEach(function (post) { %>
              <%- partial('_partial/post-card', { post: post }) %>
            <% }); %>
          <% } else { %>
            <div class="empty">还没有文章。运行 <code>hexo new "标题"</code> 开始写第一篇。</div>
          <% } %>
        </div>

        <% if (page.total > 1) { %>
          <nav class="pager">
            <% if (page.prev) { %><a href="<%- url_for(page.prev_link) %>">← 上一页</a><% } %>
            <span>第 <%= page.current %> / <%= page.total %> 页</span>
            <% if (page.next) { %><a href="<%- url_for(page.next_link) %>">下一页 →</a><% } %>
          </nav>
        <% } %>
      </div>

      <%- partial('_partial/sidebar') %>
    </div>
  </main>

  <%- partial('_partial/footer') %>
</body>
</html>
