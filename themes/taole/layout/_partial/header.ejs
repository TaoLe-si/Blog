<header class="site-header">
  <div class="wrap">
    <nav class="nav">
      <a class="brand" href="<%- url_for('/') %>">
        <span class="brand-mark">
          <%# 走 GitHub 直链，改头像能自动同步；onerror 兜到主题内置图（两者同源，
              切过去无感），避免 github.com 抽风时顶栏空一块 %>
          <img class="brand-avatar"
               src="<%- avatar_url(128) %>" width="32" height="32"
               alt="<%= config.author || config.title %>"
               decoding="async" fetchpriority="high" referrerpolicy="no-referrer"
               onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src='<%- url_for('/images/avatar.jpg') %>';}">
        </span>
        <span class="brand-text"><%= config.title %><small><%= theme.signature %></small></span>
      </a>

      <div class="nav-links">
        <%
          var menu = theme.menu || { '首页': '/' };
          var current = page.path || '';
        %>
        <% Object.keys(menu).forEach(function (name) { %>
          <%
            var link = menu[name];
            var isActive = false;
            if (link === '/') isActive = (current === '' || current === 'index.html');
            else isActive = current.indexOf(link.replace(/^\//, '')) === 0;
          %>
          <a href="<%- url_for(link) %>" class="<%= isActive ? 'active' : '' %>"><%= name %></a>
        <% }); %>
      </div>

      <div class="nav-right">
        <% if (theme.social && theme.social.github) { %>
          <a class="icon-btn" href="<%= theme.social.github %>" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.81-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
          </a>
        <% } %>
        <button class="icon-btn theme-toggle" type="button" title="深色模式" aria-label="切换到深色模式">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="icon-btn nav-toggle" type="button" aria-label="菜单">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>
