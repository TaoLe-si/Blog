<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<%
  var pageTitle = page.title || config.title;
  var siteName = config.title;
  var fullTitle = (page.title && page.type) ? (pageTitle + ' | ' + siteName) : siteName;
  if (page.type === 'post') fullTitle = pageTitle + ' | ' + siteName;
  var desc = page.description || config.description || '';
%>

<title><%= fullTitle %></title>
<meta name="description" content="<%= desc %>">

<meta property="og:type" content="<%= page.type === 'post' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:description" content="<%= desc %>">
<% if (page.type === 'post') { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<% } %>

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%235b5bd6'/%3E%3Ctext x='32' y='44' font-size='34' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'%3E%E6%A1%83%3C/text%3E%3C/svg%3E">

<% if (theme.social && theme.social.rss) { %>
<link rel="alternate" href="<%- url_for('/atom.xml') %>" title="<%= siteName %>" type="application/atom+xml">
<% } %>

<link rel="stylesheet" href="<%- asset_url('/css/style.css') %>">

<!-- MathJax v3（数学公式渲染，比 KaTeX 容错更强，国内 CDN 覆盖好） -->
<script>
  window.MathJax = {
    tex: {
      inlineMath:  [['$',  '$'],  ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      processEscapes: true,
      processEnvironments: true
    },
    options: {
      skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
      ignoreHtmlClass: 'no-math',
      processHtmlClass: 'has-math'
    },
    svg: { fontCache: 'global' },
    startup: {
      typeset: false  // 手动触发，避免与 PJAX / 异步内容冲突
    }
  };
</script>
<!-- 三个 CDN 链：bootcdn（国内）→ jsdelivr（国际）；按顺序尝试 -->
<script>
(function () {
  var SOURCES = [
    'https://cdn.bootcdn.net/ajax/libs/mathjax/3.2.2/es5/tex-svg.js',
    'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js'
  ];
  function tryLoad(i) {
    if (i >= SOURCES.length) { console.warn('MathJax: 所有 CDN 不可用'); return; }
    var s = document.createElement('script');
    s.async = true;
    s.src = SOURCES[i];
    s.onload = function () {
      if (window.MathJax && MathJax.typesetPromise) {
        MathJax.typesetPromise().catch(function (e) { console.warn('MathJax typeset error:', e); });
      }
    };
    s.onerror = function () { tryLoad(i + 1); };
    document.head.appendChild(s);
  }
  tryLoad(0);
})();
</script>

<script>
  (function () {
    try {
      var t = localStorage.getItem("blog-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  })();
</script>
