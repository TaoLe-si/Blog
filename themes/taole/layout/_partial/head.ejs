<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<%
  var pageTitle = page.title || config.title;
  var siteName = config.title;
  var fullTitle = (page.title && page.type) ? (pageTitle + ' | ' + siteName) : siteName;
  if (page.type === 'post') fullTitle = pageTitle + ' | ' + siteName;
  var desc = page.description || config.description || '';
%>

<title><%= fullTitle %></title>
<meta name="description" content="<%= desc %>">

<meta property="og:type" content="<%= page.type === 'post' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:description" content="<%= desc %>">
<% if (page.type === 'post') { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<% } %>

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%235b5bd6'/%3E%3Ctext x='32' y='44' font-size='34' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'%3E%E6%A1%83%3C/text%3E%3C/svg%3E">

<% if (theme.social && theme.social.rss) { %>
<link rel="alternate" href="<%- url_for('/atom.xml') %>" title="<%= siteName %>" type="application/atom+xml">
<% } %>

<link rel="stylesheet" href="<%- asset_url('/css/style.css') %>">

<!-- KaTeX（数学公式渲染）：国内 CDN 优先，国际 CDN 兜底 -->
<link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/KaTeX/0.16.11/katex.min.css" crossorigin="anonymous"
      onerror="this.onerror=null;this.href='https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css';">
<script>
(function () {
  // CDN 链：bootcdn（国内）→ staticfile（360，国内）→ jsdelivr（国际）
  var CDNS = [
    'https://cdn.bootcdn.net/ajax/libs/KaTeX/0.16.11/',
    'https://cdn.staticfile.org/KaTeX/0.16.11/',
    'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/'
  ];
  function loadScript(src, cb) {
    var s = document.createElement('script');
    s.defer = true;
    s.crossOrigin = 'anonymous';
    s.onload = function () { cb(true); };
    s.onerror = function () { cb(false); };
    s.src = src;
    document.head.appendChild(s);
  }
  function tryCdn(i, file, cb) {
    if (i >= CDNS.length) return cb(false);
    loadScript(CDNS[i] + file, function (ok) {
      if (ok) cb(CDNS[i]); else tryCdn(i + 1, file, cb);
    });
  }
  function runAutoRender() {
    if (typeof renderMathInElement !== 'function') return;
    renderMathInElement(document.body, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$',  right: '$',  display: false },
        { left: '\\[', right: '\\]', display: true },
        { left: '\\(', right: '\\)', display: false }
      ],
      throwOnError: false,
      errorCallback: function (msg, err) { console.warn('KaTeX error:', msg); }
    });
  }
  // 先 katex.js，再 auto-render
  tryCdn(0, 'katex.min.js', function (base) {
    if (!base) { console.warn('KaTeX: 所有 CDN 均不可用，公式将以源码形式显示'); return; }
    var i = CDNS.indexOf(base);
    tryCdn(i, 'contrib/auto-render.min.js', function (ok) {
      if (!ok) return;
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runAutoRender);
      } else {
        runAutoRender();
      }
    });
  });
})();
</script>

<script>
  (function () {
    try {
      var t = localStorage.getItem("blog-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  })();
</script>
