<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<%
  var pageTitle = page.title || config.title;
  var siteName = config.title;
  var fullTitle = (page.title && page.type) ? (pageTitle + ' | ' + siteName) : siteName;
  if (page.type === 'post') fullTitle = pageTitle + ' | ' + siteName;
  var desc = page.description || config.description || '';
%>

<title><%= fullTitle %></title>
<meta name="description" content="<%= desc %>">

<meta property="og:type" content="<%= page.type === 'post' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:description" content="<%= desc %>">
<% if (page.layout === 'post' || page.type === 'post') { %>
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<% var ogAuthor = author_of(page); %>
<% if (ogAuthor.url) { %>
<meta property="article:author" content="<%= ogAuthor.url %>">
<% } %>
<% } %>

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%235b5bd6'/%3E%3Ctext x='32' y='44' font-size='34' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'%3E%E6%A1%83%3C/text%3E%3C/svg%3E">

<% if (theme.social && theme.social.rss) { %>
<link rel="alternate" href="<%- url_for('/atom.xml') %>" title="<%= siteName %>" type="application/atom+xml">
<% } %>

<link rel="stylesheet" href="<%- asset_url('/css/style.css') %>">

<!-- KaTeX CSS + 字体（与 build 时 scripts/md-katex.js 使用的 katex 版本一致，由 scripts/katex-assets.js 拷入） -->
<link rel="stylesheet" href="<%- url_for('/css/katex/katex.min.css') %>?v=0.18.7">

<script>
  (function () {
    try {
      var t = localStorage.getItem("blog-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", t);
    } catch (e) {}
  })();
</script>
