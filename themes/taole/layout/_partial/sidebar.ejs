<%
  var topics = theme.topics || [];
  function topicCount(name) {
    var n = 0;
    site.categories.each(function (cat) {
      if (cat.name === name) n = cat.length;
    });
    return n;
  }

  var siteAuthor = default_author();
  var groups = [];
  site.posts.sort('date', -1).each(function (post) {
    var label = date(post.date, 'YYYY 年 M 月');
    var g = null;
    for (var i = 0; i < groups.length; i++) {
      if (groups[i].name === label) { g = groups[i]; break; }
    }
    if (!g) { g = { name: label, path: post.path, length: 0 }; groups.push(g); }
    g.length++;
  });
%>
<aside class="sidebar">
  <div class="widget profile-card">
    <img class="avatar" src="<%= siteAuthor.avatar %>" width="72" height="72" alt="<%= siteAuthor.name %> 的头像" decoding="async" referrerpolicy="no-referrer" onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src='<%- url_for('/images/avatar.jpg') %>';}">
    <div class="name"><%= siteAuthor.name %></div>
    <p class="quote"><%= theme.signature %></p>
    <% if (siteAuthor.bio || theme.bio) { %><p class="bio"><%= siteAuthor.bio || theme.bio %></p><% } %>
    <div class="social">
      <% if (siteAuthor.url) { %>
        <a href="<%= siteAuthor.url %>" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.81-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
        </a>
      <% } %>
      <a href="<%- url_for('/atom.xml') %>" title="RSS" aria-label="RSS">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>
  </div>

  <div class="widget">
    <h3>板块</h3>
    <ul>
      <% topics.slice(0, 5).forEach(function (t) { %>
        <li><a href="<%- url_for('/topics/') %>#<%= t.key %>"><%= t.name %> <span class="count"><%= topicCount(t.name) %></span></a></li>
      <% }); %>
      <li><a href="<%- url_for('/topics/') %>">全部板块</a></li>
    </ul>
  </div>

  <div class="widget">
    <h3>归档</h3>
    <ul>
      <% groups.slice(0, 4).forEach(function (g) { %>
        <li><a href="<%- url_for(g.path) %>"><%= g.name %> <span class="count"><%= g.length %></span></a></li>
      <% }); %>
    </ul>
  </div>

  <% if (site.tags.length) { %>
  <div class="widget">
    <h3>标签</h3>
    <div class="tag-cloud">
      <% site.tags.sort('length', -1).limit(12).each(function (tag) { %>
        <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
      <% }); %>
    </div>
  </div>
  <% } %>
</aside>
