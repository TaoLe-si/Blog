<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>" data-theme="light">
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <div class="progress-bar"></div>
  <%- partial('_partial/header') %>

  <%
    var cats = page.categories && page.categories.length ? page.categories.toArray() : [];
    var tags = page.tags && page.tags.length ? page.tags.toArray() : [];
    var plain = String(page.content || '').replace(/<[^>]+>/g, '').length;
    var mins = Math.max(1, Math.round(plain / 400));
    // 编程类 / 显式 tech: true：关闭散文首行缩进，给公式、表格、代码留排版
    var isTech = page.tech === true || cats.some(function (c) { return c.name === '编程'; });

    // 分类名 → 板块 key。topics.ejs 里锚点是 id="<key>"，
    // 直接用分类名（中文）拼 hash 会定位不到，也过不了 querySelector。
    var topicKeyOf = function (name) {
      var list = theme.topics || [];
      for (var i = 0; i < list.length; i++) {
        if (list[i].name === name || list[i].key === name) return list[i].key;
      }
      return name;
    };
  %>

  <main class="wrap">
    <div class="post-layout single">
      <article<%- isTech ? ' class="is-tech"' : '' %>>
        <header class="post-head">
          <div class="crumb">
            <a href="<%- url_for('/') %>">首页</a>
            <% if (cats.length) { %>
              / <a href="<%- url_for('/topics/') %>#<%= topicKeyOf(cats[0].name) %>"><%= cats[0].name %></a>
            <% } %>
            / <%= page.title %>
          </div>
          <h1><%= page.title %></h1>
          <div class="post-meta">
            <time datetime="<%= page.date.toISOString() %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
            <span class="sep"></span>
            <span>约 <%= mins %> 分钟</span>
            <% if (cats.length) { %>
              <span class="sep"></span>
              <span><%= cats.map(function (c) { return c.name; }).join(' · ') %></span>
            <% } %>
          </div>
          <% if (cats.length || tags.length) { %>
          <div class="post-tags">
            <% cats.forEach(function (c) { %>
              <a class="chip chip-accent" href="<%- url_for('/topics/') %>#<%= topicKeyOf(c.name) %>"><%= c.name %></a>
            <% }); %>
            <% tags.forEach(function (t) { %>
              <a class="chip" href="<%- url_for(t.path) %>"><%= t.name %></a>
            <% }); %>
          </div>
          <% } %>
        </header>

        <div class="post-body<%= isTech ? ' is-tech' : '' %>">
          <%- page.content %>
        </div>

        <footer class="post-foot" style="margin-top:40px;padding-top:22px;border-top:1px solid var(--line)">
          <% cats.forEach(function (c) { %>
            <a class="chip chip-accent" href="<%- url_for('/topics/') %>#<%= topicKeyOf(c.name) %>"><%= c.name %></a>
          <% }); %>
          <a class="read-more" href="<%- url_for('/archives/') %>">查看归档
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
          </a>
        </footer>

        <nav class="post-nav">
          <% if (page.prev) { %>
            <a class="post-nav-item" href="<%- url_for(page.prev.path) %>">
              <span>上一篇</span>
              <strong><%= page.prev.title %></strong>
            </a>
          <% } %>
          <% if (page.next) { %>
            <a class="post-nav-item next" href="<%- url_for(page.next.path) %>">
              <span>下一篇</span>
              <strong><%= page.next.title %></strong>
            </a>
          <% } %>
        </nav>
      </article>
    </div>

    <% if (theme.utterances && theme.utterances.enable) { %>
    <section class="comments" id="comments">
      <h2 class="comments-title">评论</h2>
      <div class="comments-utterances" id="comments-utterances"
           data-repo="<%= theme.utterances.repo %>"
           data-issue-term="<%= theme.utterances['issue-term'] %>"
           data-theme="<%= theme.utterances.theme %>"
           <% if (theme.utterances.label) { %>data-label="<%= theme.utterances.label %>"<% } %>
           <% if (theme.utterances.admin) { %>data-admin="<%= theme.utterances.admin %>"<% } %>
           <% if (theme.utterances.local_admin_key) { %>data-local-admin-key="<%= theme.utterances.local_admin_key %>"<% } %>
           data-issue-url="<%- url_for(page.path) %>"></div>
      <div class="comments-foot">
        <a class="comments-manage" id="comments-manage" href="#" target="_blank" rel="noopener" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <span class="manage-label">在 GitHub 上管理评论</span>
        </a>
        <span class="comments-admin-hint" id="comments-admin-hint" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
          本机已开启管理态，登录 GitHub 后你的留言会带"作者"标，并可在此页一键跳到对应 Issue 进行删除/编辑/锁帖。
        </span>
      </div>
    </section>
    <% } %>
  </main>

  <% if (String(page.content || '').match(/<h[23]/)) { %>
  <div class="toc-pop" id="toc-pop">
    <button class="toc-handle" type="button" aria-label="本页目录">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h7"/></svg>
    </button>
    <div class="toc-flyout">
      <div class="widget toc">
        <div class="toc-title">本页目录</div>
        <ol id="toc-list"></ol>
      </div>
    </div>
  </div>
  <% } %>

  <%- partial('_partial/footer') %>
</body>
</html>
